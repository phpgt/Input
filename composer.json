{
	"name": "phpgt/input",
	"description": "Encapsulated user input.",
	"license": "MIT",

	"require": {
		"php": ">=8.4",
		"phpgt/http": "^2.0",
		"phpgt/json": "^2.3"
	},

	"require-dev": {
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^12.5",
		"phpmd/phpmd": "^2.13",
		"squizlabs/php_codesniffer": "^3.7"
	},

	"autoload": {
		"psr-4": {
			"GT\\Input\\": "./src",
			"Gt\\Input\\": "./src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"GT\\Input\\Test\\": "./test/phpunit",
			"Gt\\Input\\Test\\": "./test/phpunit"
		}
	},

	"scripts": {
		"phpunit": "vendor/bin/phpunit --configuration phpunit.xml",
		"phpstan": "vendor/bin/phpstan analyse --level 6 src --memory-limit 256M",
		"phpcs": "vendor/bin/phpcs src --standard=phpcs.xml",
		"phpmd": "vendor/bin/phpmd src/ text phpmd.xml",
		"test": [
			"@phpunit",
			"@phpstan",
			"@phpcs",
			"@phpmd"
		]
	},

	"extra": {
		"branch-alias": {
			"dev-master": "1.x-dev"
		}
	},

	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/PhpGt"
		}
	],
	"config": {
		"platform": {
			"php": "8.4.0"
		}
	}
}
